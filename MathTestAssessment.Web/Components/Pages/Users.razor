
@page "/users"
@attribute [Authorize(Roles = "Admin")]
@inherits ApiPage

<PageTitle>@SelectedRole accounts</PageTitle>

<div class="page-heading">
    <div>
        <p class="eyebrow">ACCOUNT MANAGEMENT</p>

        <h1>@SelectedRole accounts</h1>

        <p>
            Review existing accounts and open a separate action to create an account or reset a password.
        </p>
    </div>
</div>

<OperationStatus Error="@Error" />

<div class="page-actions">
    <RadzenButton Text="@($"Create {SelectedRole.ToLowerInvariant()} account")"
                  Icon="person_add"
                  ButtonStyle="ButtonStyle.Primary"
                  Click="OpenCreate" />

    <RadzenButton Text="Refresh users"
                  Icon="refresh"
                  ButtonStyle="ButtonStyle.Light"
                  Click="RefreshUsers"
                  Disabled="Busy" />
</div>

<RadzenDataGrid @ref="grid"
                TItem="UserSummary"
                Data="accounts"
                Count="totalCount"
                LoadData="LoadUsers"
                AllowPaging="true"
                PagerAlwaysVisible="true"
                ShowPagingSummary="true"
                PagingSummaryFormat="Page {0} of {1} ({2} records)"
                FirstPageTitle="First page"
                FirstPageAriaLabel="First page"
                PrevPageLabel="Previous"
                NextPageLabel="Next"
                LastPageTitle="Last page"
                LastPageAriaLabel="Last page"
                PageSize="25"
                IsLoading="Busy"
                class="rz-my-4"
                EmptyText="@($"No {SelectedRole.ToLowerInvariant()} accounts found.")">

    <Columns>
        <RadzenDataGridColumn TItem="UserSummary"
                              Property="Email"
                              Title="Email"
                              Width="320px">

            <Template Context="account">
                <span class="account-email">
                    @account.Email
                </span>
            </Template>

        </RadzenDataGridColumn>

        <RadzenDataGridColumn TItem="UserSummary"
                              Property="FirstName"
                              Title="First name" />

        <RadzenDataGridColumn TItem="UserSummary"
                              Property="LastName"
                              Title="Last name" />

        <RadzenDataGridColumn TItem="UserSummary"
                              Property="RoleDisplay"
                              Title="Roles" />

        <RadzenDataGridColumn TItem="UserSummary"
                              Title="Action"
                              Sortable="false"
                              Filterable="false">

            <Template Context="account">
                <RadzenButton Text="Reset password"
                              Icon="lock_reset"
                              ButtonStyle="ButtonStyle.Warning"
                              Variant="Variant.Flat"
                              Size="ButtonSize.Small"
                              class="grid-action-button reset-button"
                              Click="@(() => OpenReset(account))"
                              Disabled="Busy" />
            </Template>

        </RadzenDataGridColumn>
    </Columns>

</RadzenDataGrid>

@code {
    [SupplyParameterFromQuery(Name = "role")]
    public string? Role { get; set; }

    private string SelectedRole =>
        string.Equals(Role, "Student", StringComparison.OrdinalIgnoreCase)
            ? "Student"
            : "Teacher";

    private List<UserSummary>? accounts;
    private RadzenDataGrid<UserSummary>? grid;

    private int totalCount;
    private string? loadedRole;

    protected override async Task OnParametersSetAsync()
    {
        if (!string.Equals(loadedRole, SelectedRole, StringComparison.Ordinal))
        {
            var roleChanged = loadedRole is not null;

            loadedRole = SelectedRole;

            if (roleChanged && grid is not null)
            {
                await grid.FirstPage(true);
            }
        }
    }

    private Task LoadUsers(LoadDataArgs args) => Run(async () =>
    {
        var pageSize = args.Top ?? 25;
        var page = (args.Skip ?? 0) / pageSize + 1;

        var result = await Api.GetAsync<PagedResponse<UserSummary>>(
            $"api/admin/users?page={page}&pageSize={pageSize}&role={SelectedRole}",
            Auth.AccessToken);

        accounts = result?.Items ?? [];
        totalCount = result?.TotalCount ?? 0;
    });

    private async Task RefreshUsers()
    {
        if (grid is not null)
        {
            await grid.Reload();
        }
    }

    private void OpenCreate()
    {
        Navigation.NavigateTo(
            $"/users/create?role={Uri.EscapeDataString(SelectedRole)}");
    }

    private void OpenReset(UserSummary account)
    {
        Navigation.NavigateTo(
            $"/users/{account.Id}/reset-password?role={Uri.EscapeDataString(SelectedRole)}&email={Uri.EscapeDataString(account.Email)}");
    }
}
