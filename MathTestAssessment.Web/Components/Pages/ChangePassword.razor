@page "/change-password"
@attribute [Authorize]
@inherits ApiPage

<PageTitle>Change password</PageTitle>

<h1>Change password</h1>

@if (Auth.MustChangePassword)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning">
        You are using a temporary password.
        Change it before continuing to the application.
    </RadzenAlert>
}
else
{
    <p>Update the password for your own account.</p>
}

<OperationStatus Busy="Busy" Error="@Error" />

<RadzenTemplateForm TItem="PasswordForm"
                    Data="model"
                    Submit="Save">

    <RadzenStack Gap="1rem"
                 Style="max-width: 520px">

        <RadzenPassword Name="CurrentPassword"
                        @bind-Value="model.CurrentPassword"
                        Placeholder="Current password"
                        aria-label="Current password" />

        <RadzenRequiredValidator Component="CurrentPassword"
                                 Text="Current password is required." />

        <RadzenPassword Name="NewPassword"
                        @bind-Value="model.NewPassword"
                        Placeholder="New password"
                        aria-label="New password" />

        <RadzenRequiredValidator Component="NewPassword"
                                 Text="New password is required." />

        <RadzenPassword Name="ConfirmPassword"
                        @bind-Value="model.ConfirmPassword"
                        Placeholder="Confirm new password"
                        aria-label="Confirm new password" />

        <RadzenRequiredValidator Component="ConfirmPassword"
                                 Text="Confirm the new password." />

        @if (!string.IsNullOrEmpty(validationError))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger">
                @validationError
            </RadzenAlert>
        }

        <p>
            Password: at least 8 characters,
            including a lowercase letter and a digit.
        </p>

        <RadzenButton Text="Change password"
                      Icon="password"
                      ButtonType="ButtonType.Submit"
                      Disabled="Busy" />

    </RadzenStack>
</RadzenTemplateForm>

@code {
    private readonly PasswordForm model = new();
    private string? validationError;

    private Task Save()
    {
        validationError = null;

        if (model.NewPassword != model.ConfirmPassword)
        {
            validationError = "The new password and confirmation do not match.";
            return Task.CompletedTask;
        }

        return Run(async () =>
        {
            await Auth.ChangePasswordAsync(
                model.CurrentPassword,
                model.NewPassword);

            Saved("Password changed successfully.");

            Navigation.NavigateTo("/", replace: true);
        });
    }

    private sealed class PasswordForm
    {
        public string CurrentPassword { get; set; } = string.Empty;

        public string NewPassword { get; set; } = string.Empty;

        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
