
@page "/users/{Id:guid}/reset-password"
@attribute [Authorize(Roles = "Admin")]
@inherits ApiPage

<PageTitle>Reset password</PageTitle>

<div class="page-heading">
    <div>
        <p class="eyebrow">ACCOUNT MANAGEMENT</p>

        <h1>Reset password</h1>

        <p>
            Set a temporary password for
            <strong>
                @(string.IsNullOrWhiteSpace(Email) ? "this user" : Email)
            </strong>.
        </p>
    </div>
</div>

<OperationStatus Busy="Busy" Error="@Error" />

<RadzenCard class="account-form-card">
    <RadzenTemplateForm TItem="ResetPasswordForm"
                        Data="model"
                        Submit="Save">

        <RadzenStack Gap="1rem">
            <RadzenPassword Name="TemporaryPassword"
                            @bind-Value="model.TemporaryPassword"
                            Placeholder="Temporary password"
                            aria-label="Temporary password" />

            <RadzenRequiredValidator Component="TemporaryPassword"
                                     Text="Temporary password is required." />

            <RadzenPassword Name="ConfirmTemporaryPassword"
                            @bind-Value="model.ConfirmPassword"
                            Placeholder="Confirm temporary password"
                            aria-label="Confirm temporary password" />

            <RadzenRequiredValidator Component="ConfirmTemporaryPassword"
                                     Text="Confirm the temporary password." />

            @if (!string.IsNullOrWhiteSpace(validationError))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger">
                    @validationError
                </RadzenAlert>
            }

            <p class="form-help">
                Existing sessions will be signed out.
                The user must replace this temporary password
                at the next sign-in.
            </p>

            <RadzenStack Orientation="Orientation.Horizontal"
                         Gap="0.75rem">

                <RadzenButton Text="Reset password"
                              Icon="lock_reset"
                              ButtonStyle="ButtonStyle.Warning"
                              ButtonType="ButtonType.Submit"
                              Disabled="Busy" />

                <RadzenButton Text="Cancel"
                              Icon="close"
                              ButtonStyle="ButtonStyle.Light"
                              Click="Back"
                              Disabled="Busy" />

            </RadzenStack>
        </RadzenStack>
    </RadzenTemplateForm>
</RadzenCard>

@code {
    [Parameter]
    public Guid Id { get; set; }

    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "role")]
    public string? Role { get; set; }

    private readonly ResetPasswordForm model = new();

    private string? validationError;

    private string SelectedRole =>
        string.Equals(Role, "Student", StringComparison.OrdinalIgnoreCase)
            ? "Student"
            : "Teacher";

    private Task Save()
    {
        validationError = null;

        if (model.TemporaryPassword != model.ConfirmPassword)
        {
            validationError = "The temporary password and confirmation do not match.";
            return Task.CompletedTask;
        }

        return Run(async () =>
        {
            await Api.SendAsync(
                HttpMethod.Post,
                "api/admin/users/reset-password",
                new
                {
                    UserId = Id,
                    model.TemporaryPassword
                },
                Auth.AccessToken);

            Saved("Temporary password created. The user must change it at the next sign-in.");

            Back();
        });
    }

    private void Back()
    {
        Navigation.NavigateTo(
            $"/users?role={Uri.EscapeDataString(SelectedRole)}");
    }

    private sealed class ResetPasswordForm
    {
        public string TemporaryPassword { get; set; } = string.Empty;

        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
