@page "/students"
@attribute [Authorize(Roles = "Teacher")]
@inherits ApiPage

<PageTitle>Students</PageTitle>

<h1>Students</h1>

<OperationStatus Error="@Error" />

<RadzenButton Text="Create student"
              Icon="person_add"
              Click="@(() => Navigation.NavigateTo("/students/create"))"
              class="rz-mr-3" />

<RadzenButton Text="Refresh"
              Icon="refresh"
              Click="RefreshGrid"
              Disabled="Busy" />

<RadzenDataGrid @ref="grid"
                TItem="StudentDto"
                Data="students"
                Count="totalCount"
                LoadData="LoadStudents"
                AllowPaging="true"
                PagerAlwaysVisible="true"
                ShowPagingSummary="true"
                PagingSummaryFormat="Page {0} of {1} ({2} records)"
                FirstPageTitle="First page"
                FirstPageAriaLabel="First page"
                PrevPageLabel="Previous"
                NextPageLabel="Next"
                LastPageTitle="Last page"
                LastPageAriaLabel="Last page"
                PageSize="10"
                IsLoading="Busy"
                EmptyText="No students found."
                class="rz-my-4">

    <Columns>
        <RadzenDataGridColumn TItem="StudentDto"
                              Property="ExternalStudentId"
                              Title="ID" />

        <RadzenDataGridColumn TItem="StudentDto"
                              Property="FirstName"
                              Title="First name" />

        <RadzenDataGridColumn TItem="StudentDto"
                              Property="LastName"
                              Title="Last name" />

        <RadzenDataGridColumn TItem="StudentDto"
                              Title="Actions"
                              Filterable="false"
                              Sortable="false">

            <Template Context="student">
                <RadzenLink Path="@($"/students/{student.Id}")"
                            Text="Details"
                            class="rz-mr-3" />

                <RadzenLink Path="@($"/analytics?studentId={student.Id}")"
                            Text="Analytics" />

                <AuthorizeView Roles="Teacher"
                               Context="permission">

                    <RadzenButton Icon="edit"
                                  aria-label="Edit student"
                                  Click="@(() => Edit(student))"
                                  Disabled="Busy" />

                </AuthorizeView>
            </Template>

        </RadzenDataGridColumn>
    </Columns>

</RadzenDataGrid>

@code {
    private List<StudentDto>? students;
    private RadzenDataGrid<StudentDto>? grid;

    private int totalCount;

    private Task LoadStudents(LoadDataArgs args) => Run(async () =>
    {
        var pageSize = args.Top ?? 10;
        var page = (args.Skip ?? 0) / pageSize + 1;

        var result = await Api.GetAsync<PagedResponse<StudentDto>>(
            $"api/students/paged?page={page}&pageSize={pageSize}",
            Auth.AccessToken);

        students = result?.Items ?? [];
        totalCount = result?.TotalCount ?? 0;
    });

    private async Task RefreshGrid()
    {
        if (grid is not null)
        {
            await grid.Reload();
        }
    }

    private void Edit(StudentDto student)
    {
        Navigation.NavigateTo($"/students/{student.Id}/edit");
    }
}
